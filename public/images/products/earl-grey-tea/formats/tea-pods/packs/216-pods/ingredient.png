<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 900" role="img" aria-labelledby="title desc">
  <title id="title">Ingredient preview</title>
  <desc id="desc">Stylized tea ingredients including leaves, citrus, and spice tones.</desc>
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#5f7d3d" />
      <stop offset="55%" stop-color="#b8894f" />
      <stop offset="100%" stop-color="#d8bc8a" />
    </linearGradient>
    <filter id="blur" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="24" />
    </filter>
  </defs>
  <rect width="1200" height="900" fill="url(#bg)" />
  <circle cx="230" cy="190" r="150" fill="#f4e8cd" opacity="0.35" filter="url(#blur)" />
  <circle cx="910" cy="210" r="180" fill="#f9f1dc" opacity="0.25" filter="url(#blur)" />
  <circle cx="1020" cy="690" r="210" fill="#7d5027" opacity="0.22" filter="url(#blur)" />
  <g fill="#1c2b17" opacity="0.82">
    <ellipse cx="330" cy="520" rx="120" ry="44" transform="rotate(-18 330 520)" />
    <ellipse cx="520" cy="560" rx="132" ry="48" transform="rotate(12 520 560)" />
    <ellipse cx="700" cy="500" rx="126" ry="46" transform="rotate(-9 700 500)" />
  </g>
  <g fill="#f3c37a" opacity="0.9">
    <circle cx="865" cy="560" r="60" />
    <circle cx="930" cy="610" r="44" />
    <circle cx="812" cy="620" r="36" />
  </g>
  <text x="76" y="118" font-size="44" font-family="Georgia, serif" fill="#fff7e8" letter-spacing="3">INGREDIENTS</text>
</svg>
